{
  "name": "polyglot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc && cp -r src/admin/ui dist/admin/ui",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "ai": "^7.0.22",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/provider": "^4.0.3",
    "hono": "^4.12.30",
    "@hono/node-server": "^2.0.8",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10",
    "@types/node": "^26.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@biomejs/biome": "^2.5.3"
  }
}
