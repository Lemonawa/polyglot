    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@biomejs/biome": "^1.9.0"
  }
}
